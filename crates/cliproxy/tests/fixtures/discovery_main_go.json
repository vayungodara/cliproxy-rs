  "dotenv": [
    {
      "in": "A=1\nB=2\n",
      "out": {
        "A": "1",
        "B": "2"
      },
      "err": ""
    },
    {
      "in": "export A=1",
      "out": {
        "A": "1"
      },
      "err": ""
    },
    {
      "in": "exportA=1",
      "out": {
        "exportA": "1"
      },
      "err": ""
    },
    {
      "in": "  A = spaced value  \n",
      "out": {
        "A": "spaced value"
      },
      "err": ""
    },
    {
      "in": "A=x # comment\nB=y#notcomment",
      "out": {
        "A": "x",
        "B": "y#notcomment"
      },
      "err": ""
    },
    {
      "in": "A=a #b #c",
      "out": {
        "A": "a #b"
      },
      "err": ""
    },
    {
      "in": "# only comment\n\nA=1",
      "out": {
        "A": "1"
      },
      "err": ""
    },
    {
      "in": "A='single $A \\n'",
      "out": {
        "A": "single $A \\n"
      },
      "err": ""
    },
    {
      "in": "A=\"double \\n \\r \\t \\\\ \\$A\"",
      "out": {
        "A": "double \n \r t \\ $A"
      },
      "err": ""
    },
    {
      "in": "A=1\nB=${A}-$A-$(A)-\\$A-${A",
      "out": {
        "A": "1",
        "B": "1-1-1)-$A-1"
      },
      "err": ""
    },
    {
      "in": "B=$lower $ ${}",
      "out": {
        "B": "$lower $ ${}"
      },
      "err": ""
    },
    {
      "in": "A=\"unterminated",
      "out": {},
      "err": "unterminated quoted value \"unterminated"
    },
    {
      "in": "A=1\nB",
      "out": {
        "": "B",
        "A": "1"
      },
      "err": ""
    },
    {
      "in": "B",
      "out": {
        "": "B"
      },
      "err": ""
    },
    {
      "in": "Ü=1",
      "out": {},
      "err": "unexpected character \"\\u009c\" in variable name near \"Ü=1\""
    },
    {
      "in": "é=1",
      "out": {},
      "err": "unexpected character \"©\" in variable name near \"é=1\""
    },
    {
      "in": "A.B=1\nC_D=2",
      "out": {
        "A.B": "1",
        "C_D": "2"
      },
      "err": ""
    },
    {
      "in": "A:yaml",
      "out": {
        "A": "yaml"
      },
      "err": ""
    },
    {
      "in": "A=\"q\\\"uoted\"",
      "out": {
        "A": "q\"uoted"
      },
      "err": ""
    },
    {
      "in": "A=''",
      "out": {
        "A": ""
      },
      "err": ""
    },
    {
      "in": "A=\"\"\"x\"",
      "out": {
        "A": ""
      },
      "err": "unexpected character \"\\\"\" in variable name near \"\\\"x\\\"\""
    },
    {
      "in": "A=1\r\nB=2\r\n",
      "out": {
        "A": "1",
        "B": "2"
      },
      "err": ""
    },
    {
      "in": "A=\"x\" trailing",
      "out": {
        "": "trailing",
        "A": "x"
      },
      "err": ""
    },
    {
      "in": "A=1\nA=2\nB=$A",
      "out": {
        "A": "2",
        "B": "2"
      },
      "err": ""
    },
    {
      "in": "A=\"multi\nline\"",
