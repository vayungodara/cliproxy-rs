        "A": "multi\nline"
      },
      "err": ""
    },
    {
      "in": "A B=1",
      "out": {
        "A B": "1"
      },
      "err": ""
    },
    {
      "in": "A= v ",
      "out": {
        "A": "v"
      },
      "err": ""
    },
    {
      "in": " A=1",
      "out": {
        "A": "1"
      },
      "err": ""
    },
    {
