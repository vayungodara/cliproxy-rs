# Maintainer: Vayun Godara <187050579+vayungodara@users.noreply.github.com>
pkgname=cliproxy-rs-bin
pkgver=0.4.0
pkgrel=1
pkgdesc='Use DeepSeek, GLM, Kimi, OpenRouter and more in Codex CLI and Claude Code: one local endpoint, API translation, failover'
arch=('x86_64' 'aarch64')
url='https://github.com/vayungodara/cliproxy-rs'
license=('MIT')
depends=('glibc' 'libgcc' 'libstdc++')
options=('!debug' '!strip')
provides=('cliproxy-rs')
conflicts=('cliproxy-rs')
source_x86_64=("$url/releases/download/v$pkgver/cliproxy-$pkgver-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/cliproxy-$pkgver-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('01099eed22b4c2e5f5c4f9da2026c6da27d9f2bccc15043ccc1a30877b4a6c8e')
sha256sums_aarch64=('dd5df31d38ef41aa1902078c25ef298781e439859be2ea794d6472a0c54ae1b5')

package() {
  cd "cliproxy-$pkgver-$CARCH-unknown-linux-gnu"
  install -Dm755 cliproxy "$pkgdir/usr/bin/cliproxy"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
